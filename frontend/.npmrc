# react-day-picker 8.10.1 declares a peer range of react ^16.8 || ^17 || ^18, and this
# project runs React 19. npm 7+ treats an unmet peer as a hard install failure, so a clean
# clone -- which is exactly what a CI or Vercel build does -- stops with ERESOLVE before it
# ever reaches the build step. Local installs only appeared to work because the committed
# lockfile already recorded a resolution and npm never had to solve the graph again.
#
# This flag restores npm 6 behaviour: an unsatisfiable peer becomes a warning rather than an
# error. It does NOT make the pairing supported -- react-day-picker 8 is a React 18-era
# component and is still being run on React 19. The real fix is to move to
# react-day-picker 9, which supports React 19 and drops the date-fns peer entirely, but that
# is a breaking API change in src/components/ui/calendar.jsx and is deliberately not bundled
# into a dependency-pinning change.
legacy-peer-deps=true
