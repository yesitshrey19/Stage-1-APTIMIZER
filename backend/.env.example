# Aptimizer backend configuration — copy to backend/.env and fill in.
#
#   cp backend/.env.example backend/.env
#
# backend/.env is gitignored and must stay that way: it holds the JWT signing key, the
# first admin password and the AI key. Nothing here is a real secret — every value below
# is either a safe default or an obvious placeholder.
#
# On Render these are set in the dashboard, not in a file. See render.yaml: JWT_SECRET is
# generated there, and MONGO_URL, ADMIN_EMAIL, ADMIN_PASSWORD and GEMINI_API_KEY are
# marked `sync: false` so they are entered once and never committed.

# ---------------------------------------------------------------- database (required)
# Local development. For a deployment use the MongoDB Atlas connection string.
MONGO_URL=mongodb://localhost:27017
DB_NAME=aptimizer

# ---------------------------------------------------------------- auth (required)
# Signs access and refresh tokens. Any long random string; change it and every existing
# session is invalidated, which is the correct behaviour if it ever leaks.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string

# The first admin account, created on first boot. Use a real password: this account can
# reach every project in the deployment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Origin allowed through CORS. The Docker image serves the app and the API from one
# origin, so this only matters when the frontend runs separately, as it does in dev.
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------- AI (optional)
# Without a key APT and the AI reports disable themselves and say so, and clause
# retrieval falls back to keyword-only. Nothing crashes. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# Embedding model for the IS/NBC clause index. Changing it after the index is built makes
# codesearch refuse the stored vectors and drop to keyword-only rather than score one
# model's vectors against another's queries; rebuild with:
#   cd backend && python -m codesearch build --force
# GEMINI_EMBED_MODEL=gemini-embedding-001

# ---------------------------------------------------------------- local convenience
# Serves the interactive API docs at /docs, /redoc and /openapi.json. Commented out on
# purpose: this file gets copied onto servers, and the safe default has to survive that.
# Uncomment for local work; never set it on a public deployment, which has no reason to
# publish a map of its own API surface.
# ENABLE_API_DOCS=true
